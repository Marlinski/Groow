#!/usr/bin/env bash
# birth: the one script. Prepares Groow's home, builds its body if needed, and wakes it up.
#
# The first time there is no birth certificate in the home, so the body gives birth: it fetches
# the base model and writes the certificate. Every later time it simply wakes up. Idempotent,
# and outside Groow's reach.
#
#   ./birth                start, or give birth        ./birth stop     put it to sleep
#   ./birth ui             open the window             ./birth say "…"  say something to it
#   ./birth status         is it awake?                ./birth logs     follow the body
#   ./birth shell          a shell in the home, as the mind
#   ./birth rebuild        rebuild the body, keep the home
#
# Everything that talks to the core goes through the container as root, because that is who
# the core recognises as its mentor. The mind inside is an ordinary user and cannot do any of
# it, however it asks.
set -euo pipefail
cd "$(dirname "$0")"

need() { command -v "$1" >/dev/null 2>&1 || { echo "birth: $1 is required"; exit 1; }; }
need docker

running() { [ -n "$(docker compose ps -q --status running groow 2>/dev/null)" ]; }
core()    { docker compose exec -T -u 0 groow groow --state /home/groow/state "$@"; }

case "${1:-start}" in
  stop)    docker compose stop groow; echo "groow is asleep (its home is kept in ./home)";;
  logs)    docker compose logs -f groow;;
  shell)   docker compose exec -u groow groow bash -l;;
  rebuild) docker compose build groow && docker compose up -d groow;;
  status)  running && core status || echo "not awake; ./birth to wake it";;
  ui)      running || { echo "not awake; ./birth to wake it"; exit 1; }
           docker compose exec -u 0 groow groow --state /home/groow/state ui;;
  say)     shift; running || { echo "not awake; ./birth to wake it"; exit 1; }
           core say "$@";;
  start)
    echo "birth: body = the docker image, rebuilt from the Dockerfile · home = ./home, yours and persistent"
    if running; then
      echo "birth: already awake"; core status; exit 0
    fi
    mkdir -p home/.nix home/state home/workspace
    if ! docker image inspect groow:latest >/dev/null 2>&1; then
      echo "birth: no body yet; building the image (the core, torch, the runtime; a few minutes, once)…"
      docker compose build groow
    else
      echo "birth: body present (image groow:latest)"
    fi
    if [ -f home/state/birth.json ]; then
      echo "birth: certificate found in ./home/state, so this is a waking, not a birth"
    else
      echo "birth: no certificate, so this is a birth. The body will fetch the base model (about 8 GB, once)."
    fi
    docker compose up -d groow 2>&1 | grep -E "Created|Recreated|Started|Running" | sed 's/^/birth: container /' || true
    echo "birth: waiting for it to answer…"
    for _ in $(seq 1 900); do
      if running && core status >/dev/null 2>&1; then
        core status
        echo "birth: ./birth ui  |  ./birth say \"hello\"  |  ./birth logs  |  ./birth stop"
        exit 0
      fi
      if ! running; then
        echo "birth: the body stopped. Last lines:"; docker compose logs --tail 20 groow; exit 1
      fi
      sleep 2
    done
    echo "birth: still not answering after thirty minutes; see ./birth logs"; exit 1;;
  *) echo "usage: ./birth [start|stop|ui|say|status|logs|shell|rebuild]"; exit 2;;
esac
