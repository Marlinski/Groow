#!/usr/bin/env bash
# birth: the one script. Prepares Groow's home, builds its body if needed, and wakes it up.
# The first time, the body finds no birth certificate in the home and gives birth (fetches the
# base model). Every later time it just wakes up. Idempotent. Lives outside Groow's reach.
#
#   ./birth            start (or give birth)        ./birth stop      put it to sleep
#   ./birth logs       follow the body's log        ./birth shell     a shell in the home, as groow
#   ./birth status     is it awake?                 ./birth rebuild   rebuild the body, keep the home
set -euo pipefail
cd "$(dirname "$0")"
export GROOW_UID="$(id -u)" GROOW_GID="$(id -g)"
URL="http://127.0.0.1:${GROOW_PORT:-7373}"

need() { command -v "$1" >/dev/null 2>&1 || { echo "birth: $1 is required"; exit 1; }; }
need docker

case "${1:-start}" in
  stop)    docker compose stop groow; echo "groow is asleep (home kept in ./home)";;
  logs)    docker compose logs -f groow;;
  shell)   docker compose exec groow bash -l;;
  status)  curl -fsS "$URL/status" 2>/dev/null | python3 -m json.tool || echo "not awake ($URL)";;
  rebuild) docker compose build groow && docker compose up -d groow;;
  start)
    echo "birth: body = the docker image (read-only, rebuilt from the Dockerfile) · home = ./home (yours, persistent, the whole of Groow)"
    if curl -fsS "$URL/status" >/dev/null 2>&1; then
      WHO=$(curl -fsS "$URL/status" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("body","?"))' 2>/dev/null)
      if [ "$WHO" = "sandbox" ]; then
        echo "birth: already awake in its body at $URL"; exit 0
      fi
      echo "birth: something else already answers at $URL (body: $WHO). Stop it first (groow stop), or use another port."; exit 1
    fi
    mkdir -p home/.nix home/state home/workspace       # owned by you, so the body (running as you) can write them
    if ! docker image inspect groow:latest >/dev/null 2>&1; then
      echo "birth: no body yet: building the image (CUDA base, torch, the groow runtime; a few minutes, once)…"
      docker compose build groow
    else
      echo "birth: body present (image groow:latest)"
    fi
    if [ -f home/state/birth.json ]; then
      echo "birth: certificate found in ./home/state: this is a wake-up, not a birth (no download)"
    else
      echo "birth: no certificate in ./home: this is a birth. The body will fetch the base model (~8 GB, once) into the home."
    fi
    docker compose up -d groow 2>&1 | grep -E "Created|Recreated|Started|Running" | sed 's/^/birth: container /'
    echo "birth: following the body's log until it answers on $URL …"
    ( docker compose logs -f --no-log-prefix --since 5s groow 2>/dev/null | grep --line-buffered -E "^(groow|birth|body)" | sed -u 's/^/   │ /' ) &
    LOGS=$!
    stop_logs() { pkill -P "$LOGS" 2>/dev/null || true; kill "$LOGS" 2>/dev/null || true; wait "$LOGS" 2>/dev/null || true; }
    trap 'stop_logs' EXIT
    for i in $(seq 1 900); do
      if curl -fsS "$URL/hello" >/dev/null 2>&1; then
        sleep 0.5; stop_logs
        curl -fsS "$URL/hello" | python3 -c 'import sys,json; h=json.load(sys.stdin); b=h["birth"]; print("birth:", b["name"], "is awake · id", b["id"], "· born", b["born_text"], "· age", b["age"], "·", h["url"])'
        echo "birth: groow ui   |   groow chat   |   groow ask \"…\"   |   ./birth logs   |   groow stop"
        exit 0
      fi
      if [ -z "$(docker compose ps -q --status running groow 2>/dev/null)" ]; then
        stop_logs; echo "birth: the body is not running. Last lines:"; docker compose logs --tail 20 groow; exit 1
      fi
      sleep 2
    done
    stop_logs; echo "birth: still not awake after 30 minutes; see ./birth logs";;
  *) echo "usage: ./birth [start|stop|logs|shell|status|rebuild]"; exit 2;;
esac
