#!/usr/bin/env python3
"""Arithmetic: `arithmetic drill [--rounds N] [--level 1|2|3]` mental arithmetic, answers scored and logged to your activity log."""
import json
import os
import random
import re
import time
import urllib.request
import uuid
from pathlib import Path

SYSTEM = "Answer with the final number only."


def _brain():
    return os.environ.get("GROOW_BRAIN", "http://127.0.0.1:7374")


def _complete(convs, max_new_tokens=12, temperature=1.0):
    """Generate one answer per conversation. The brain serves one at a time, so these go in
    order; the loop is deliberately simple because a game is background work."""
    out = []
    for messages in convs:
        req = urllib.request.Request(
            _brain() + "/generate",
            data=json.dumps({
                "messages": messages, "tools": [], "max_new_tokens": max_new_tokens,
                "temperature": temperature, "top_p": 0.95, "top_k": 40,
                "enable_thinking": False, "priority": 4,
            }).encode(),
            headers={"Content-Type": "application/json"},
        )
        text = ""
        with urllib.request.urlopen(req, timeout=600) as r:
            for line in r:
                line = line.strip()
                if not line:
                    continue
                d = json.loads(line)
                if d.get("done"):
                    text = d.get("text", text)
                elif "error" in d:
                    raise RuntimeError(d["error"])
        out.append(text)
    return out


def _question(rng, level):
    op = rng.choice("+-*")
    hi = {1: 20, 2: 99, 3: 999}[level]
    a, b = rng.randint(2, hi), rng.randint(2, hi)
    if op == "*":
        b = rng.randint(2, 12 if level < 3 else 99)
    return f"{a} {op} {b}", eval(f"{a}{op}{b}")


def _drill(rounds=3, n=16, level=2, rng=None):
    """Ask yourself questions you can check, and see how many you get right.

    Nothing is written anywhere. This used to append every answer and the score it earned to an
    activity log, back when a drill could feed its own reward into training; nothing reads that
    log now, and a skill that writes its own score would be the mind grading itself, which is
    the one thing it must not do. What it is for is the answer on the screen.
    """
    rng = rng or random.Random()
    summary = []
    for r in range(rounds):
        qs = [_question(rng, level) for _ in range(n)]
        convs = [[{"role": "system", "content": SYSTEM}, {"role": "user", "content": f"What is {q}?"}] for q, _ in qs]
        outs = _complete(convs)
        correct = 0
        for (q, ans), out in zip(qs, outs):
            nums = re.findall(r"-?\d+", (out or "").replace(",", ""))
            correct += bool(nums) and int(nums[-1]) == ans
        summary.append({"round": r + 1, "accuracy": round(correct / n, 3)})
    return {"rounds": summary,
            "note": "how many you got right, now. Nothing here is recorded or trained on."}


def main(argv: list) -> dict:
    """arithmetic drill [--rounds N] [--level 1|2|3]"""
    if not argv or argv[0] in ("-h", "--help"):
        return {"text": "usage: arithmetic drill [--rounds 3] [--level 2]   questions, answers scored, logged"}
    if argv[0] == "--selftest":
        q, a = _question(random.Random(0), 1); return {"ok": True, "example": f"{q} = {a}"}
    opts = {argv[i].lstrip("-"): int(argv[i + 1]) for i in range(1, len(argv) - 1, 2) if argv[i].startswith("--")}
    try:
        if argv[0] == "drill":
            return _drill(rounds=opts.get("rounds", 3), level=opts.get("level", 2))
    except Exception as e:
        return {"error": f"{type(e).__name__}: {e}", "hint": "is groow awake? this needs its /complete endpoint"}
    return {"error": f"unknown action {argv[0]}"}


TESTS = [("arithmetic", {"argv": ["--selftest"]}, {"ok": True})]


def _run():
    import sys
    out = main(sys.argv[1:])
    if isinstance(out, dict) and "text" in out and len(out) == 1:
        print(out["text"])
    else:
        print(json.dumps(out, ensure_ascii=False, indent=1))
    raise SystemExit(0 if not (isinstance(out, dict) and out.get("error")) else 1)


if __name__ == "__main__":
    _run()
